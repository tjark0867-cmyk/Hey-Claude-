<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gestoppt"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Starten" />

        <Button
            android:id="@+id/ask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jetzt fragen (ohne „Hey Claude“)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="Letzte Frage"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lastQ"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:text="–" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Antwort"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lastA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:text="–" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="28dp"
            android:text="Einstellungen"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Claude API-Schlüssel" />

        <EditText
            android:id="@+id/apiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="sk-ant-…"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:singleLine="true" />

        <Button
            android:id="@+id/getKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="API-Schlüssel besorgen" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Modell (Standard: claude-haiku-5-5, am schnellsten)" />

        <EditText
            android:id="@+id/model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="true" />

        <CheckBox
            android:id="@+id/webSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Websuche für aktuelle Infos (Wetter, News …)" />

        <CheckBox
            android:id="@+id/followUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nach Rückfragen von Claude automatisch weiter zuhören" />

        <CheckBox
            android:id="@+id/location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Standort an Claude senden (Wetter, Orte in der Nähe …)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:text="Stimme"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="ElevenLabs API-Schlüssel (für eine echte, natürliche Stimme – leer lassen = Handy-Stimme)" />

        <EditText
            android:id="@+id/elevenKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="sk_…"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:singleLine="true" />

        <Button
            android:id="@+id/getElevenKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ElevenLabs-Schlüssel besorgen" />

        <TextView
            android:id="@+id/voiceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Stimme: George" />

        <Button
            android:id="@+id/chooseVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stimme auswählen" />

        <CheckBox
            android:id="@+id/elevenFast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Schneller antworten (Flash-Modell, etwas weniger natürlich)" />

        <Button
            android:id="@+id/testVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stimme testen" />

        <TextView
            android:id="@+id/voiceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:text="" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Speichern" />

        <Button
            android:id="@+id/battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Akku-Optimierung ausschalten (empfohlen)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:text="Updates"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/updateInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="" />

        <CheckBox
            android:id="@+id/autoUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Automatisch aktualisieren (im WLAN)" />

        <Button
            android:id="@+id/allowUpdates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Updates erlauben (einmalig nötig)" />

        <Button
            android:id="@+id/checkUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jetzt nach Update suchen" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:textSize="13sp"
            android:text="So geht es:API-Schlüssel eintragen → „Starten“ → App kann geschlossen werden. Sag „Hey Claude“, warte auf den Piep und stell deine Frage. Solange der Assistent läuft, siehst du eine Benachrichtigung und den grünen Mikrofon-Punkt. Nach einem Update oder Neustart des Handys einfach auf den Hinweis tippen – dann höre ich wieder zu." />

    </LinearLayout>
</ScrollView>
